rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "seleraku.cs1@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', 'pending') in ['staff', 'admin'])
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATORS
    // -------------------------------------------------------------------------
    function isValidMember(data) {
      return data.keys().hasAll(['name', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 256 &&
             data.status in ['active', 'inactive'];
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 256;
    }

    function isValidItem(data) {
      return data.keys().hasAll(['name', 'price', 'stock']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 256 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    function isValidSaving(data) {
      return data.keys().hasAll(['memberId', 'amount', 'type']) &&
             isValidId(data.memberId) &&
             data.amount is number && data.amount > 0 &&
             data.type in ['pokok', 'wajib', 'sukarela'];
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['memberId', 'amount', 'status', 'type', 'date']) &&
             isValidId(data.memberId) &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'approved', 'rejected', 'active', 'completed'] &&
             data.type in ['cash', 'goods'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['date', 'type', 'totalAmount', 'paymentMethod']) &&
             data.type in ['purchase', 'sale'] &&
             data.paymentMethod in ['cash', 'credit'] &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    function isValidRepayment(data) {
      return data.keys().hasAll(['loanId', 'amount', 'date', 'memberId', 'type']) &&
             isValidId(data.loanId) &&
             isValidId(data.memberId) &&
             data.amount is number && data.amount > 0 &&
             data.type in ['cash', 'goods'];
    }

    // -------------------------------------------------------------------------
    // COLLECTION RULES
    // -------------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read, list: if true; 
      allow create: if isStaff();
      allow update: if isStaff() || true; // Simplified for member portal
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && isValidSupplier(incoming());
      allow update: if isStaff() && isValidSupplier(incoming());
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /savings/{savingId} {
      allow read, list: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /loans/{loanId} {
      allow read, list: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, list: if true;
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /repayments/{repaymentId} {
      allow read, list: if true;
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

  }
}
